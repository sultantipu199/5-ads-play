# Omnichannel Agency Engine Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
SECRET_PROVIDER=env # Options: env, keyring, vault
DATABASE_URL=sqlite+aiosqlite:///agency_engine.db

# Telegram Reporting Bot (Leave blank if dry-run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_APPROVAL_ALLOWLIST=

# Platform API Credentials (Injected via Environment or Keyring)
META_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_REFRESH_TOKEN=
